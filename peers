def last_on_thread(name: str, target: str) -> Path | None:
    for e in reversed(load_thread(name)):
        if e.get("target") == target:
            p = Path(e["dir"])
            if p.exists():
                return p
    return None


def last_distinct_peers(name: str, limit: int = 6) -> list[str]:
    seen: list[str] = []
    for e in reversed(load_thread(name)):
        t = e.get("target")
        if t and t not in seen:
            seen.append(t)
        if len(seen) >= limit:
            break
    seen.reverse()
    return seen


def cmd_huddle(args: argparse.Namespace, task: str) -> int:
    apply_thread(args, Path(args.cwd).resolve())
    if not args.thread:
        die("huddle needs a thread (cd into a git repo, or pass --thread name)")
    explicit = parse_with(args)
    if explicit:
        names = explicit
    else:
        names = last_distinct_peers(args.thread)
        if not names:
            other = P.pick_one()
            if other:
                names = [other]
    invoke, native = split_self(names, args) if names else ([], P.detect_caller())
    if not invoke:
        # still huddle the last non-self run on the thread
        for e in reversed(load_thread(args.thread)):
            t = e.get("target")
            if t and not P.is_self(t):
                invoke = [t]
                break
    if not invoke:
        die(
            f"huddle needs a peer run on thread `{args.thread}` first.\n"
            f"  {PROG} research \"your question\"\n"
            f"  {PROG} huddle"
        )
    if not task.strip():
        task = HUDDLE_TASK
    parent = new_run(args.name or "huddle")

    def one(target: str) -> tuple[str, Path, int, str]:
        ns = clone_ns(
            args,
            target=target,
            agent=args.agent or "consult",
            name=f"huddle-{target}",
            fresh=False,
            see=["thread"],
            full=False if args.card_only else True,
            dry_run=args.dry_run,
        )
        rc, run_dir, status = run_target(ns, task, silent=True)
        return target, run_dir, rc, status

    results = {}
    with ThreadPoolExecutor(max_workers=min(POOL, max(1, len(invoke)))) as ex:
        futs = [ex.submit(one, t) for t in invoke]
        for fut in as_completed(futs):
            target, run_dir, rc, status = fut.result()
            results[target] = (run_dir, rc, status)
    parts = ["# HUDDLE — peers read the desk (RESULT + TRANSCRIPT + your notes).\n"]
    extra: dict[str, str] = {
        "THREAD": str(thread_dir(args.thread) / "thread.md"),
        "DESK": "+".join(invoke + ([f"{native}(you)"] if native else [])),
    }
    fail = 0
    for t in invoke:
        run_dir, rc, st = results[t]
        if rc != 0:
            fail += 1
        parts += [
            f"## {t.upper()} after reading the desk ({st})\n{read(run_dir / 'result.md')}\n",
            f"TRANSCRIPT: {run_dir / 'transcript.md'}\n",
        ]
        extra[f"{t.upper()}_RESULT"] = str(run_dir / "result.md")
        extra[f"{t.upper()}_TRANSCRIPT"] = str(run_dir / "transcript.md")
    if native or P.detect_caller():
        who = native or P.detect_caller()
        parts.append(
            f"## {who} (you, native)\n"
            "Read the TRANSCRIPT paths above in this session. Respond here. "
            f"Do not `{PROG} {who}`.\n"
        )
        extra["NATIVE"] = f"you are {who} — read the transcripts, respond here"
    extra["MERGED"] = str(parent / "result.md")
    write(parent / "result.md", "\n".join(parts))
    status = "done" if fail == 0 else "blocked"
    print_card(parent, status, extra)
    return 0 if fail == 0 else 1


