def thread_dir(name: str) -> Path:
    ensure_desk()
    d = THREADS / slug(name)
    d.mkdir(parents=True, exist_ok=True)
    try:
        os.chmod(d, 0o700)
    except OSError:
        pass
    idx = d / "runs.json"
    if not idx.exists():
        write(idx, "[]\n")
    return d


def load_thread(name: str) -> list[dict]:
    return json.loads(read(thread_dir(name) / "runs.json") or "[]")


def save_thread(name: str, entries: list[dict]) -> None:
    d = thread_dir(name)
    write(d / "runs.json", json.dumps(entries, indent=2) + "\n")
    lines = [f"# thread {slug(name)}", ""]
    handoff = d / "handoff.md"
    if handoff.exists():
        lines += ["## caller notes", read(handoff).strip(), ""]
    lines += ["| # | who | role | status | result | transcript |", "|---|---|---|---|---|---|"]
    for i, e in enumerate(entries, 1):
        rd = Path(e["dir"])
        lines.append(
            f"| {i} | {e.get('target','')} | {e.get('agent','')} | {e.get('status','')} "
            f"| `{rd / 'result.md'}` | `{rd / 'transcript.md'}` |"
        )
    write(d / "thread.md", "\n".join(lines) + "\n")


def append_thread(name: str, run_dir: Path, target: str, agent: str, status: str) -> None:
    entries = load_thread(name)
    entries.append(
        {
            "id": run_dir.name,
            "dir": str(run_dir),
            "target": target,
            "agent": agent,
            "status": status,
        }
    )
    save_thread(name, entries)


def append_note(name: str, note: str) -> None:
    d = thread_dir(name)
    prev = read(d / "handoff.md")
    stamp = time.strftime("%Y-%m-%d %H:%M")
    write(d / "handoff.md", prev + f"\n## {stamp}\n{note.strip()}\n")


def resolve_run(spec: str) -> Path:
    spec = spec.strip()
    if spec == "last":
        if not LAST.exists():
            die("no last run")
        return Path(LAST.read_text().strip())
    p = Path(spec).expanduser()
    if p.is_file():
        p = p.parent
    if p.is_dir() and (p / "result.md").exists():
        return p
    cand = RUNS / spec
    if cand.is_dir():
        return cand
    matches = sorted(RUNS.glob(f"*{spec}*")) if RUNS.exists() else []
    if len(matches) == 1:
        return matches[0]
    die(f"cannot resolve run '{spec}'")
    return cand


def should_inline(status: str, agent: str, transcript: str, full: bool, card_only: bool) -> bool:
    if card_only:
        return False
    if full:
        return True
    if status in ("blocked", "needs-decision", "timeout", "unknown", "auth"):
        return True
    if agent in ("review", "consult") and len(transcript) <= INLINE_LIMIT:
        return True
    return len(transcript) <= INLINE_LIMIT


def format_peer_bundle(run_dir: Path, agent: str, full: bool, card_only: bool) -> str:
    result = read(run_dir / "result.md") or "(no result.md)"
    transcript = read(run_dir / "transcript.md")
    meta = json.loads(read(run_dir / "meta.json") or "{}")
    status = meta.get("status") or "unknown"
    who = f"{meta.get('target', '?')} {meta.get('agent', '?')}"
    parts = [
        f"### {who}  RUN {run_dir.name}  STATUS {status}",
        f"PROMPT: {run_dir / 'prompt.md'}",
        f"RESULT: {run_dir / 'result.md'}",
        f"TRANSCRIPT: {run_dir / 'transcript.md'}",
        "RESULT card:",
        result.strip() or "(empty)",
    ]
    if should_inline(status, agent, transcript, full, card_only) and transcript.strip():
        body = transcript.strip()
        if len(body) > INLINE_LIMIT and not full:
            body = body[:INLINE_LIMIT] + f"\n… truncated; full file: {run_dir / 'transcript.md'}\n"
        parts += ["Transcript (inlined because the card is likely missing context):", body]
    else:
        parts.append(
            "Transcript not inlined (save tokens). If you need attempts, errors, "
            f"rejected options, or reasoning, Read {run_dir / 'transcript.md'} now."
        )
    return "\n".join(parts)


def collect_see(args: argparse.Namespace) -> list[Path]:
    specs: list[str] = []
    if getattr(args, "against", None):
        specs.append(args.against)
    for s in getattr(args, "see", None) or []:
        specs.append(s)
    thread = getattr(args, "thread", None)
    fresh = getattr(args, "fresh", False)
    if thread and not fresh and "thread" not in specs:
        specs.append("thread")
    out: list[Path] = []
    seen: set[str] = set()
    for spec in specs:
        if spec == "thread":
            if not thread:
                die("--see thread needs a thread (cd into a git repo)")
            for e in load_thread(thread):
                p = Path(e["dir"])
                if p.exists() and str(p) not in seen:
                    seen.add(str(p))
                    out.append(p)
            continue
        p = resolve_run(spec)
        if str(p) not in seen:
            seen.add(str(p))
            out.append(p)
    return out


def build_prompt(args: argparse.Namespace, task: str, cwd: Path) -> str:
    caller = P.detect_caller()
    parts = [
        ROLES[args.agent],
        RESEARCH_CONTRACT if args.agent == "research" else CONTRACT,
        f"You are `{args.target}` on this desk."
        + (f" The caller is `{caller}` — a different product. Do not call them back via peers." if caller else ""),
        D.lean_in(args.target),
        "Repo snapshot (names only, not diffs):",
        repo_snapshot(cwd),
    ]
    thread = getattr(args, "thread", None)
    if thread:
        d = thread_dir(thread)
        parts += [
            f"You are on thread `{slug(thread)}`. Colleagues leave RESULT cards and transcripts here.",
            f"Thread index: {d / 'thread.md'}",
        ]
        handoff = read(d / "handoff.md")
        if handoff.strip():
            parts += ["Caller notes (what a peer on this desk already knows):", handoff.strip()]
    note = getattr(args, "note", None)
    if note:
        parts += ["Additional note from the caller:", note.strip()]
        if thread:
            append_note(thread, note)
    bundles = collect_see(args)
    if bundles:
        parts.append(
            "Peer work on this desk. Start from RESULT cards. "
            "Read a TRANSCRIPT if you are missing why/how/what-failed."
        )
        full = getattr(args, "full", False)
        card_only = getattr(args, "card_only", False)
        seen_who: set[str] = set()
        for b in bundles:
            parts.append(format_peer_bundle(b, args.agent, full, card_only))
            meta = json.loads(read(b / "meta.json") or "{}")
            other = meta.get("target")
            if other and other != args.target and other not in seen_who:
                seen_who.add(other)
                line = D.counterpart(other)
                dpath = D.dossier_path(other)
                extra = f" Counterpart {other}: {line}"
                if dpath:
                    extra += f" Dossier (Read only if you need how they fail): {dpath}"
                parts.append(extra)
    parts += ["Task:", task.strip()]
    return "\n\n".join(parts) + "\n"


def isolate_worktree(cwd: Path, run_id: str) -> Path:
    git = which("git")
    if not git:
        die("--isolate needs git")
    wt = ROOT / "wt" / run_id
    wt.parent.mkdir(parents=True, exist_ok=True)
    p = subprocess.run(
        [git, "worktree", "add", "-b", f"peers/{run_id}", str(wt), "HEAD"],
        cwd=cwd,
        capture_output=True,
        text=True,
    )
    if p.returncode != 0:
        die(f"worktree failed: {p.stderr.strip() or p.stdout.strip()}")
    return wt


def _kill_pg(proc: subprocess.Popen) -> None:
    try:
        os.killpg(os.getpgid(proc.pid), signal.SIGTERM)
    except (OSError, ProcessLookupError):
        try:
            proc.kill()
        except OSError:
            pass


def _write_live(run_dir: Path, lines: list[str], elapsed: int, last: str, who: str) -> None:
    tail = [ln for ln in lines if ln.strip()][-24:]
    write(run_dir / "live.md", "".join(tail) if tail else "(no output yet)\n")
    write(
        run_dir / "status.json",
        json.dumps({"who": who, "elapsed": elapsed, "last": last[:200], "status": "running"}) + "\n",
    )


def run_cmd(
    argv: list[str],
    cwd: Path,
    timeout: int,
    *,
    run_dir: Path | None = None,
    who: str = "",
) -> tuple[int, str, str]:
    """Stream the other branch into this session. Transcript on disk; heartbeats on stdout."""
    prefix = f"[{who}] " if who else ""
    out_lines: list[str] = []
    err_lines: list[str] = []
    last = ""
    started = time.time()
    try:
        proc = subprocess.Popen(
            argv,
            cwd=cwd,
            stdin=subprocess.DEVNULL,
            stdout=subprocess.PIPE,
            stderr=subprocess.PIPE,
            text=True,
            bufsize=1,
            env=P._run_env(),
            start_new_session=True,
        )
    except FileNotFoundError:
        return 3, "", f"{PROG}: command not found: {argv[0]}\n"

    q: Queue = Queue()

    def pump(stream, tag: str) -> None:
        try:
            for line in iter(stream.readline, ""):
                q.put((tag, line))
        finally:
            q.put((tag, None))

    threading.Thread(target=pump, args=(proc.stdout, "out"), daemon=True).start()
    threading.Thread(target=pump, args=(proc.stderr, "err"), daemon=True).start()
    done = {"out": False, "err": False}
    last_beat = 0.0
    timed_out = False

    while not (done["out"] and done["err"] and proc.poll() is not None):
        if time.time() - started > timeout:
            timed_out = True
            _kill_pg(proc)
            break
        try:
            tag, line = q.get(timeout=0.4)
        except Empty:
            now = time.time()
            if now - last_beat >= 4:
                elapsed = int(now - started)
                snippet = last[:72] if last else "working"
                print(f"{prefix}… {elapsed}s  {snippet}", flush=True)
                if run_dir:
                    _write_live(run_dir, out_lines, elapsed, last, who)
                last_beat = now
            continue
        if line is None:
            done[tag] = True
            continue
        if tag == "out":
            out_lines.append(line)
            stripped = ANSI.sub("", line).strip()
            if stripped and not stripped.startswith(("> build", "> ")):
                last = stripped
            if run_dir:
                with (run_dir / "transcript.md").open("a", encoding="utf-8") as fh:
                    fh.write(ANSI.sub("", line))
        else:
            err_lines.append(line)
            if run_dir:
                with (run_dir / "stderr.log").open("a", encoding="utf-8") as fh:
                    fh.write(line)

    # drain
    while True:
        try:
            tag, line = q.get_nowait()
        except Empty:
            break
        if line is None:
            continue
        if tag == "out":
            out_lines.append(line)
        else:
            err_lines.append(line)

    try:
        proc.wait(timeout=3)
    except subprocess.TimeoutExpired:
        _kill_pg(proc)
        proc.wait(timeout=3)

    out = "".join(out_lines)
    err = "".join(err_lines)
    if timed_out:
        return 142, out, err + f"\n{PROG}: TIMEOUT after {timeout}s\n"
    return proc.returncode or 0, out, err


def auth_blocked_result(detail: str, login: str) -> str:
    return (
        "## RESULT\nSTATUS: auth\n"
        f"SUMMARY: this CLI is not logged in ({detail}). "
        "peers has no account of its own.\n"
        f"FIX: {login}\n"
        "THEN: peers doctor\n"
        "RETRY: if doctor already showed this CLI as ok, retry the same peer once "
        "(Cursor's 'Starting login process' banner is not a logout)\n"
        "FILES: none\nVERIFY: n/a\nDECISION: run FIX in a real terminal, then doctor, then retry\n"
        "DISAGREE: none\n"
    )


def empty_or_auth_status(rc: int, stdout: str, stderr: str, transcript: str) -> tuple[str, str] | None:
    blob = f"{stdout}\n{stderr}\n{transcript}"
    if RESULT_RE.search(transcript):
        return None
    if "press any key" in blob.lower() or (
        P.AUTH_FAIL.search(blob) and not P.CURSOR_LOGIN_CHATTER.search(blob)
    ):
        return "auth", auth_blocked_result(
            "login/401 detected in output",
            "peers doctor — if that peer is ok, retry once",
        )
    if rc == 142 and not transcript.strip():
        return "timeout", (
            "## RESULT\nSTATUS: timeout\n"
            "SUMMARY: timed out with an empty transcript — usually a login prompt, "
            "a hung CLI, or a provider that never wrote output. Run `peers doctor`.\n"
            "FILES: none\nVERIFY: n/a\nDECISION: peers doctor, then retry\nDISAGREE: none\n"
        )
    if rc == 0 and not transcript.strip():
        return "blocked", (
            "## RESULT\nSTATUS: blocked\n"
            "SUMMARY: CLI exited 0 but wrote an empty transcript. "
            "Treat as failed. Check LOG and `peers doctor`.\n"
            "FILES: none\nVERIFY: n/a\nDECISION: none\nDISAGREE: none\n"
        )
    return None


def finish_run(run_dir: Path, rc: int, stdout: str, stderr: str) -> str:
    transcript = strip_ansi(stdout)
    write(run_dir / "transcript.md", transcript)
    write(run_dir / "stderr.log", stderr)
    forced = empty_or_auth_status(rc, stdout, stderr, transcript)
    if forced:
        status, result = forced
    else:
        result, status = extract_result(transcript)
        if rc == 142:
            status = "timeout"
            result = (
                "## RESULT\nSTATUS: timeout\nSUMMARY: timed out\n"
                "FILES: none\nVERIFY: n/a\nDECISION: none\nDISAGREE: none\n"
            )
        elif rc != 0 and status in ("done", "unknown"):
            status = "blocked"
    write(run_dir / "result.md", result)
    meta_path = run_dir / "meta.json"
    meta = json.loads(read(meta_path) or "{}")
    meta.update({"rc": rc, "status": status})
    write(meta_path, json.dumps(meta, indent=2) + "\n")
    observe(meta.get("target") or "", status, result)
    return status


def observe(who: str, status: str, result: str) -> None:
    """Cheap empirical log. Promote into dossiers/ when a pattern repeats. No LLM."""
    m = re.search(r"^DISAGREE:\s*(.*)$", result, re.M)
    disagree = (m.group(1).strip() if m else "")
    interesting = status in ("auth", "timeout", "blocked") or (
        disagree and disagree.lower() not in ("none", "n/a", "no", "-", "")
    )
    if not interesting:
        return
    line = f"- {time.strftime('%Y-%m-%d %H:%M')} `{who}` STATUS {status}"
    if disagree and disagree.lower() not in ("none", "n/a", "no", "-", ""):
        line += f" DISAGREE: {disagree[:200]}"
    path = ROOT / "observed.md"
    prev = read(path)
    if not prev:
        prev = (
            "# observed\n\n"
            "Empirical notes from this desk. Outranks blog dossiers when they conflict.\n\n"
        )
    write(path, prev + line + "\n")


def ns_defaults(args: argparse.Namespace) -> None:
    for k, v in {
        "thread": None,
        "see": None,
        "against": None,
        "full": False,
        "card_only": False,
        "fresh": False,
        "note": None,
        "isolate": False,
        "force": True,
        "dry_run": False,
        "model": None,
        "timeout": None,
        "name": None,
        "no_thread": False,
        "allow_self": False,
        "with_peers": None,
        "agent": "worker",
        "cwd": os.getcwd(),
        "target": None,
        "task_file": None,
        "task": None,
    }.items():
        if not hasattr(args, k):
            setattr(args, k, v)


def parse_with(args: argparse.Namespace) -> list[str] | None:
    w = getattr(args, "with_peers", None)
    if not w:
        return None
    parts = [p.strip() for p in w.replace("+", ",").split(",") if p.strip()]
    if not parts:
        die("--with wants names, e.g. opus,codex,gemini")
    seen: list[str] = []
    for p in parts:
        if p not in seen:
            seen.append(p)
    return seen


def ensure_not_self(who: str, args: argparse.Namespace) -> None:
    if getattr(args, "allow_self", False) or P.allow_self():
        return
    if P.is_self(who):
        die(P.self_message(who))


def run_target(args: argparse.Namespace, task: str, *, silent: bool = False) -> tuple[int, Path, str]:
    ns_defaults(args)
    cwd = Path(args.cwd).resolve()
    if not cwd.is_dir():
        die(f"cwd not a directory: {cwd}")
    apply_thread(args, cwd)
    ensure_not_self(args.target, args)
    try:
        prov, model, alias = P.resolve(args.target, args.model)
    except KeyError as e:
        die(str(e))
    args.target = alias
    prompt = build_prompt(args, task, cwd)
    run_dir = new_run(args.name or f"{alias}-{args.agent}")
    extra: dict[str, str] = {"PEER": alias, "PROVIDER": prov.id}
    work_cwd = cwd
    if args.isolate:
        wt = isolate_worktree(cwd, run_dir.name)
        work_cwd = wt
        extra["WORKTREE"] = str(wt)
        extra["BRANCH"] = f"peers/{run_dir.name}"
    if args.thread:
        extra["THREAD"] = str(thread_dir(args.thread) / "thread.md")
    write(run_dir / "prompt.md", prompt)
    write(
        run_dir / "meta.json",
        json.dumps(
            {
                "target": alias,
                "provider": prov.id,
                "agent": args.agent,
                "cwd": str(work_cwd),
                "model": model,
                "thread": args.thread,
            },
            indent=2,
        )
        + "\n",
    )
    if args.dry_run:
        write(
            run_dir / "result.md",
            "## RESULT\nSTATUS: dry-run\nSUMMARY: prompt written, not executed\n"
            "FILES: none\nVERIFY: n/a\nDECISION: none\nDISAGREE: none\n",
        )
        if args.thread:
            append_thread(args.thread, run_dir, alias, args.agent, "dry-run")
        if not silent:
            print_card(run_dir, "dry-run", extra)
        return 0, run_dir, "dry-run"

    bin = prov.find()
    if not bin:
        die(f"{prov.id} not on PATH\n  {prov.hint}")
    state, detail = P.probe(prov)
    if state != "ok":
        write(run_dir / "result.md", auth_blocked_result(detail, prov.login))
        write(run_dir / "transcript.md", "")
        write(run_dir / "stderr.log", f"{state}: {detail}\n")
        if args.thread:
            append_thread(args.thread, run_dir, alias, args.agent, "auth")
        if not silent:
            print_card(
                run_dir,
                "auth",
                {
                    **extra,
                    "FIX": prov.login,
                    "THEN": "peers doctor",
                    "RETRY": "if doctor already showed this CLI ok, retry the same peer once — Cursor's login banner is not a logout",
                },
            )
        return 1, run_dir, "auth"

    argv = prov.argv(bin, model, prompt, args.force, args.agent)
    timeout = args.timeout or prov.timeout
    extra["LIVE"] = str(run_dir / "transcript.md")
    extra["TAIL"] = str(run_dir / "live.md")
    write(run_dir / "transcript.md", "")
    write(run_dir / "stderr.log", "")
    write(run_dir / "live.md", "(waiting)\n")
    print(
        f"STATUS: running\nPEER: {alias}\nLIVE: {run_dir / 'transcript.md'}\n"
        f"TAIL: {run_dir / 'live.md'}\n"
        + (f"THREAD: {extra['THREAD']}\n" if "THREAD" in extra else ""),
        flush=True,
    )
    rc, out, err = run_cmd(argv, work_cwd, timeout, run_dir=run_dir, who=alias)
    if prov.id == "dsv4" and rc == 0:
        m = re.search(r"^OUTPUT:\s+(\S+)", out, re.M)
        if m:
            got = P.safe_read_path(m.group(1), extra_roots=[ROOT, run_dir])
            if got is not None:
                out = got
    status = finish_run(run_dir, rc, out, err)
    if args.thread:
        append_thread(args.thread, run_dir, alias, args.agent, status)
    if not silent:
        extra_out = dict(extra)
        if status == "auth":
            extra_out["FIX"] = prov.login
            extra_out["THEN"] = "peers doctor"
            extra_out["RETRY"] = (
                "if doctor already showed this CLI ok, retry the same peer once "
                "— Cursor's login banner is not a logout"
            )
        print_card(run_dir, status, extra_out)
    if rc == 142:
        return 2, run_dir, status
    return (0 if rc == 0 and status not in ("auth", "blocked", "timeout") else 1), run_dir, status


def clone_ns(args: argparse.Namespace, **over: object) -> argparse.Namespace:
    d = dict(vars(args))
    d.update(over)
    return argparse.Namespace(**d)


def split_self(names: list[str], args: argparse.Namespace) -> tuple[list[str], str | None]:
    """Drop the caller's own product. That half of the desk is this session."""
    if getattr(args, "allow_self", False) or P.allow_self():
        return names, None
    invoke: list[str] = []
    native: str | None = None
    for t in names:
        if P.is_self(t):
            native = t
        else:
            invoke.append(t)
    return invoke, native


def resolve_desk(
    args: argparse.Namespace,
    *,
    n: int = 3,
    role: str | None = None,
    task: str = "",
) -> tuple[list[str], str | None]:
    """Who to spawn, plus you (native) when the caller is already a peer."""
    caller = P.detect_caller()
    explicit = parse_with(args)
    if explicit:
        invoke, native = split_self(explicit, args)
        if not invoke:
            die("that desk is only you. Use native Task, or pick someone else (`peers providers`).")
        return invoke, native
    have = P.available_aliases(exclude_self=True, authed=True)
    if not have:
        die(
            "need an authenticated peer that isn't you.\n"
            f"  caller: {caller or 'unknown'}\n"
            f"  {PROG} doctor"
        )
    if role and task:
        picked = D.route_many(task, role, have, n=n)
    else:
        picked = P.pick_desk(n)
    if not picked:
        picked = have[:n]
    native = None
    if caller and not getattr(args, "allow_self", False) and not P.allow_self():
        native = caller
    return picked, native


def cmd_fanout(
    args: argparse.Namespace,
    task: str,
    invoke: list[str],
    native: str | None,
    *,
    title: str,
    tasks: dict[str, str] | None = None,
) -> int:
    apply_thread(args, Path(args.cwd).resolve())
    parent = new_run(args.name or f"{title.lower()}-{args.agent}")
    desk = "+".join(invoke + ([f"{native}(you)"] if native else []))
    extra = {"DESK": desk}
    print(f"DESK: {desk}", flush=True)
    if native:
        extra["NATIVE"] = (
            f"you are {native} — your take in THIS session. "
            f"Then `{PROG} note \"your take\"` and `{PROG} huddle`."
        )
    if args.thread:
        extra["THREAD"] = str(thread_dir(args.thread) / "thread.md")
        if native:
            append_note(
                args.thread,
                f"caller ({native}) is taking this independently in-session. "
                "Do not wait for a CLI run of that product.",
            )
    prior = list(args.see or [])
    if args.thread and not args.fresh:
        prior.extend(e["dir"] for e in load_thread(args.thread))
    if args.dry_run:
        who = ", ".join(invoke) + (" + you" if native else "")
        write(
            parent / "result.md",
            "## RESULT\nSTATUS: dry-run\n"
            f"SUMMARY: would run {who} independently, then they share a thread\n"
            "FILES: none\nVERIFY: n/a\nDECISION: none\nDISAGREE: none\n",
        )
        print_card(parent, "dry-run", extra)
        return 0

    def one(target: str) -> tuple[str, Path, int, str]:
        ns = clone_ns(
            args,
            target=target,
            name=f"{target}-{args.agent}",
            fresh=True,
            see=prior,
            dry_run=False,
        )
        piece = (tasks or {}).get(target, task)
        rc, run_dir, status = run_target(ns, piece, silent=True)
        return target, run_dir, rc, status

    results: dict[str, tuple[Path, int, str]] = {}
    with ThreadPoolExecutor(max_workers=min(POOL, max(1, len(invoke)))) as ex:
        futs = {ex.submit(one, t): t for t in invoke}
        for fut in as_completed(futs):
            target, run_dir, rc, status = fut.result()
            results[target] = (run_dir, rc, status)

    parts = [f"# {title} — independent first pass ({desk}). Next: `{PROG} huddle`.\n"]
    extra_paths: dict[str, str] = dict(extra)
    fail = 0
    for t in invoke:
        run_dir, rc, st = results[t]
        if rc != 0:
            fail += 1
        parts += [
            f"## {t.upper()} ({st})\n{read(run_dir / 'result.md')}\n",
            f"TRANSCRIPT: {run_dir / 'transcript.md'}\n",
        ]
        extra_paths[f"{t.upper()}_RESULT"] = str(run_dir / "result.md")
        extra_paths[f"{t.upper()}_TRANSCRIPT"] = str(run_dir / "transcript.md")
    if native:
        parts.append(
            f"## {native.upper()} (you, native)\n"
            "Do your independent take here. Do not spawn your own CLI.\n"
            f"Then: `{PROG} note \"…\"` and `{PROG} huddle`.\n"
        )
        extra_paths["NEXT"] = f"{PROG} note \"your take\" && {PROG} huddle"
    else:
        extra_paths["NEXT"] = f"{PROG} huddle"
    extra_paths["MERGED"] = str(parent / "result.md")
    merged = "\n".join(parts)
    write(parent / "result.md", merged)
    write(parent / "transcript.md", merged)
    write(
        parent / "meta.json",
        json.dumps(
            {"invoke": invoke, "native": native, "thread": args.thread, "title": title},
            indent=2,
        )
        + "\n",
    )
    status = "done" if fail == 0 else "blocked"
    print_card(parent, status, extra_paths)
    return 0 if fail == 0 else 1


def cmd_both(args: argparse.Namespace, task: str) -> int:
