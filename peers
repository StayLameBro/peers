def die(msg: str, code: int = 3) -> None:
    print(f"{PROG}: {msg}", file=sys.stderr)
    raise SystemExit(code)


_BIN_OK = re.compile(r"^/[A-Za-z0-9._/-]+$")


def peers_bin_dir() -> Path:
    raw = os.environ.get("PEERS_BIN") or str(Path.home() / ".local/bin")
    p = Path(raw).expanduser()
    if not p.is_absolute() or not _BIN_OK.match(str(p)):
        die("PEERS_BIN must be an absolute path (letters, digits, . _ - /)")
    return p


def _refuse_checkout_desk(root: Path) -> None:
    """Live transcripts must not land in the public git checkout."""
    pkg = PACKAGE.resolve()
    git = pkg / ".git"
    if not git.is_dir() and not git.is_file():
        return
    try:
        rel = root.resolve().relative_to(pkg)
    except ValueError:
        return
    if rel.parts and rel.parts[0] == "tests":
        return
    die(
        f"PEERS_HOME is inside the peers git checkout ({root}).\n"
        "  That would commit transcripts. Unset PEERS_HOME "
        "(default is ~/.local/share/peers/desk).\n"
        "  Tests: export PEERS_HOME to a path under tests/"
    )


def ensure_desk() -> None:
    _refuse_checkout_desk(ROOT)
    for d in (ROOT, RUNS, THREADS):
        d.mkdir(parents=True, exist_ok=True)
        try:
            os.chmod(d, 0o700)
        except OSError:
            pass


def which(name: str) -> str | None:
    return shutil.which(name)


def strip_ansi(text: str) -> str:
    text = ANSI.sub("", text)
    lines = [
        ln
        for ln in text.splitlines()
        if ln.strip() and not ln.strip().startswith(("> build", "> "))
    ]
    return "\n".join(lines).strip() + "\n"


def write(path: Path, text: str) -> None:
    path.parent.mkdir(parents=True, exist_ok=True)
    try:
        os.chmod(path.parent, 0o700)
    except OSError:
        pass
    path.write_text(text, encoding="utf-8")
    try:
        os.chmod(path, 0o600)
    except OSError:
        pass


def read(path: Path) -> str:
    return path.read_text(encoding="utf-8", errors="replace") if path.exists() else ""


def slug(name: str) -> str:
    s = re.sub(r"[^a-zA-Z0-9_-]+", "-", name).strip("-")
    return s[:48] or "thread"


def auto_thread(cwd: Path) -> str:
    git = which("git")
    if git:
        p = subprocess.run(
            [git, "rev-parse", "--show-toplevel"],
            cwd=cwd, capture_output=True, text=True, timeout=5,
        )
        if p.returncode == 0 and p.stdout.strip():
            return slug(Path(p.stdout.strip()).name)
    return slug(cwd.name) or "desk"


def apply_thread(args: argparse.Namespace, cwd: Path) -> None:
    ns_defaults(args)
    if getattr(args, "no_thread", False):
        args.thread = None
        return
    args.thread = slug(args.thread) if args.thread else auto_thread(cwd)


def repo_snapshot(cwd: Path) -> str:
    lines = [f"cwd: {cwd}"]
    git = which("git")
    if not git:
        return "\n".join(lines)

    def git_out(*a: str) -> str:
        p = subprocess.run([git, *a], cwd=cwd, capture_output=True, text=True, timeout=8)
        return p.stdout.strip() if p.returncode == 0 else ""

    branch = git_out("rev-parse", "--abbrev-ref", "HEAD")
    if branch:
        lines.append(f"branch: {branch}")
    dirty = git_out("diff", "--name-only", "HEAD")
    names = [n for n in dirty.splitlines() if n][:20]
    if names:
        lines.append("dirty: " + ", ".join(names))
        if len(dirty.splitlines()) > 20:
            lines.append("dirty: (truncated at 20 names; no diffs)")
    return "\n".join(lines)


def extract_result(transcript: str) -> tuple[str, str]:
    m = RESULT_RE.search(transcript)
    if m:
        block = transcript[m.start() :].strip() + "\n"
        sm = STATUS_RE.search(block)
        status = (sm.group(1) if sm else "unknown").lower().rstrip(",")
        return block, status
    tail = "\n".join(transcript.strip().splitlines()[-20:])
    block = (
        "## RESULT\nSTATUS: unknown\n"
        "SUMMARY: (no RESULT card; last 20 transcript lines)\n"
        f"{tail}\nFILES: none\nVERIFY: n/a\nDECISION: none\nDISAGREE: none\n"
    )
    return block, "unknown"


def new_run(name: str) -> Path:
    ensure_desk()
    rid = f"{int(time.time())}-{os.getpid()}-{slug(name)}"
    d = RUNS / rid
    d.mkdir(parents=True)
    try:
        os.chmod(d, 0o700)
    except OSError:
        pass
    write(LAST, str(d) + "\n")
    return d


def print_card(run_dir: Path, status: str, extra: dict[str, str] | None = None) -> None:
