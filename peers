def parse_jobs(text: str) -> list[tuple[str, str, str]]:
    jobs = []
    for raw in text.splitlines():
        line = raw.strip()
        if not line or line.startswith("#"):
            continue
        if ":" not in line:
            die(f"bad job line (want `grok worker: task`): {line}")
        head, task = line.split(":", 1)
        parts = head.split()
        if len(parts) != 2:
            die(f"bad job head (want `target agent`): {head}")
        target, agent = parts
        try:
            P.resolve(target)
        except KeyError:
            die(f"unknown target '{target}' — peers providers")
        if agent not in AGENTS:
            die(f"unknown agent '{agent}'")
        jobs.append((target, agent, task.strip()))
    if not jobs:
        die("no jobs")
    return jobs


def cmd_parallel(args: argparse.Namespace, blob: str) -> int:
    jobs = parse_jobs(blob)
    parent = new_run(args.name or "parallel")
    if args.dry_run:
        write(
            parent / "result.md",
            "## RESULT\nSTATUS: dry-run\nSUMMARY: "
            + "; ".join(f"{t} {a}" for t, a, _ in jobs)
            + "\nFILES: none\nVERIFY: n/a\nDECISION: none\nDISAGREE: none\n",
        )
        print_card(parent, "dry-run", {"JOBS": str(len(jobs))})
        return 0

    def one(i: int, target: str, agent: str, task: str) -> tuple[int, str, str, Path, int, str]:
        ns = clone_ns(args, target=target, agent=agent, name=f"{i}-{target}-{agent}", dry_run=False)
        try:
            rc, run_dir, status = run_target(ns, task, silent=True)
        except SystemExit as e:
            rc = int(e.code) if isinstance(e.code, int) else 1
            run_dir = parent
            status = "blocked"
        return i, target, agent, run_dir, rc, status

    rows = []
    ok = fail = 0
    with ThreadPoolExecutor(max_workers=min(POOL, max(1, len(jobs)))) as ex:
        futs = [ex.submit(one, i, t, a, task) for i, (t, a, task) in enumerate(jobs, 1)]
        for fut in as_completed(futs):
            i, target, agent, run_dir, rc, status = fut.result()
            rows.append((i, target, agent, status, run_dir, rc))
            if rc == 0:
                ok += 1
            else:
                fail += 1
    rows.sort()
    index = ["# parallel", "", "| # | target | agent | status | result | transcript |", "|---|---|---|---|---|---|"]
    for i, target, agent, status, run_dir, _rc in rows:
        index.append(
            f"| {i} | {target} | {agent} | {status} | `{run_dir / 'result.md'}` | `{run_dir / 'transcript.md'}` |"
        )
    write(parent / "result.md", "\n".join(index) + "\n")
    print_card(
        parent,
        "done" if fail == 0 else "blocked",
        {"JOBS": str(len(jobs)), "OK": str(ok), "FAIL": str(fail), "INDEX": str(parent / "result.md")},
    )
    return 0 if fail == 0 else 1


def cmd_auto(args: argparse.Namespace, task: str) -> int:
