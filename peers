    print()
    ready = P.available_aliases(exclude_self=True, authed=True)
    print("ready      " + (", ".join(ready) or "(none)"))
    desk = P.pick_desk(3)
    if caller and desk:
        print(f"desk       {'+'.join(desk)} + you({caller})")
    else:
        print("desk       " + ("+".join(desk) if desk else "(need an authenticated peer)"))
    if oc_ok:
        print("gateway    opencode /connect  →  peers zai | kimi | ollama | provider/model")
    print()
    print("login      peers has no account. AUTH means that CLI needs its own login")
    print("           in a real terminal (not a sandbox), then: peers doctor")
    if cursor_ok:
        print("           Cursor ok. status may print 'Starting login process' — that is a banner, not a logout.")
    if need_login:
        print("           run:")
        for pid, cmd in need_login:
            print(f"             {cmd}")
    if missing_backend:
        print(f"{PROG}: no coding CLI on PATH. Install one, or: opencode /connect", file=sys.stderr)
        return 3
    if not ready:
        print(f"{PROG}: the only logged-in CLI is you. Native Task, or log into another plan.", file=sys.stderr)
        return 0
    print(f"NEXT: {PROG} auto \"task\"")
    return 0


def cmd_setup() -> int:
    bin_dir = peers_bin_dir()
    pkg = PACKAGE
    home = Path.home()
    mapping = [
        (pkg / "skills/claude/SKILL.md", home / ".claude/skills/peers/SKILL.md"),
        (pkg / "skills/claude/SKILL.md", home / ".claude/skills/delegate/SKILL.md"),
        (pkg / "skills/cursor/SKILL.md", home / ".cursor/skills/peers/SKILL.md"),
        (pkg / "skills/cursor/SKILL.md", home / ".cursor/skills/delegate/SKILL.md"),
        (pkg / "skills/agents/SKILL.md", home / ".agents/skills/peers/SKILL.md"),
        (pkg / "skills/agents/SKILL.md", home / ".agents/skills/delegate/SKILL.md"),
        (pkg / "skills/agents/SKILL.md", home / ".codex/skills/peers/SKILL.md"),
        (pkg / "commands/peers.md", home / ".claude/commands/peers.md"),
    ]
    for src_p, dest in mapping:
        if not src_p.exists():
            print(f"skip {dest} (packaged skill missing: {src_p})")
            continue
        dest.parent.mkdir(parents=True, exist_ok=True)
        dest.write_text(src_p.read_text(encoding="utf-8"), encoding="utf-8")
        print(f"ok   {dest}")
    for stale in (
        home / ".claude/skills/peerdesk",
        home / ".cursor/skills/peerdesk",
        home / ".agents/skills/peerdesk",
        home / ".local/share/peerdesk",
    ):
        if stale.is_dir():
            shutil.rmtree(stale)
            print(f"ok   removed {stale}")
    grok_cmd = home / ".claude/commands/grok.md"
    if grok_cmd.exists():
        grok_cmd.unlink()
        print(f"ok   removed {grok_cmd}")
    peer_cmd = home / ".claude/commands/peer.md"
    if peer_cmd.exists():
        peer_cmd.unlink()
        print(f"ok   removed {peer_cmd}")
    bin_dir.mkdir(parents=True, exist_ok=True)
    me = Path(__file__).resolve()
    dest = bin_dir / "peers"
    if dest.is_symlink() or dest.exists():
        dest.unlink()
    dest.symlink_to(me)
    print(f"ok   {dest} -> {me}")
    for old in ("peer", "grok46", "opus-peer"):
        dest = bin_dir / old
        if dest.is_symlink() or dest.exists():
            dest.unlink()
            print(f"ok   removed {dest}")
    print(f"{PROG} setup: skills + PATH shims installed")
    return 0


def cmd_last() -> int:
    if not LAST.exists():
        die("no runs yet")
    run_dir = Path(LAST.read_text().strip())
    result = run_dir / "result.md"
    if not result.exists():
        die(f"no result in {run_dir}")
    sys.stdout.write(read(result))
    print(f"RESULT: {result}", file=sys.stderr)
    print(f"TRANSCRIPT: {run_dir / 'transcript.md'}", file=sys.stderr)
    return 0


def cmd_show(spec: str) -> int:
    run_dir = resolve_run(spec)
    print(f"RUN: {run_dir.name}")
    print(f"RESULT: {run_dir / 'result.md'}")
    print(f"TRANSCRIPT: {run_dir / 'transcript.md'}")
    print(f"PROMPT: {run_dir / 'prompt.md'}")
    print()
    sys.stdout.write(read(run_dir / "result.md"))
    return 0


def cmd_cat(spec: str) -> int:
    run_dir = resolve_run(spec)
    sys.stdout.write(read(run_dir / "transcript.md"))
    return 0


def cmd_thread(name: str | None) -> int:
    if not name:
        if not THREADS.exists():
            print("no threads yet")
            return 0
        for d in sorted(THREADS.iterdir()):
            if d.is_dir():
                n = len(load_thread(d.name))
                print(f"{d.name:24} {n} turns  {d / 'thread.md'}")
        return 0
    d = thread_dir(name)
    save_thread(name, load_thread(name))
    sys.stdout.write(read(d / "thread.md"))
    print(f"THREAD: {d / 'thread.md'}", file=sys.stderr)
    return 0


def cmd_ls() -> int:
    if not RUNS.exists():
        print("no runs yet")
        return 0
    rows = sorted(RUNS.iterdir(), key=lambda p: p.stat().st_mtime, reverse=True)[:20]
    print(f"{'run':40} {'who':16} status")
    for d in rows:
        meta = json.loads(read(d / "meta.json") or "{}")
        who = f"{meta.get('target','?'):8} {meta.get('agent','?')}"
        print(f"{d.name:40} {who:16} {meta.get('status','')}")
    return 0


def add_common(p: argparse.ArgumentParser, default_agent: str = "worker") -> None:
    p.add_argument("--agent", choices=AGENTS, default=default_agent)
    p.add_argument("--model", default=None)
    p.add_argument("--timeout", type=int, default=None)
    p.add_argument("--file", dest="task_file", default=None)
    p.add_argument("--against", default=None, help="compat: path to a result.md (same as --see)")
    p.add_argument("--see", action="append", default=None, help="last | thread | run-id | path (repeatable)")
    p.add_argument("--thread", default=None, help="shared desk name; defaults to the repo folder")
    p.add_argument("--note", default=None, help="what YOU already know — written onto the thread")
    p.add_argument("--full", action="store_true", help="inline transcripts")
    p.add_argument("--card-only", action="store_true", help="never inline transcripts")
    p.add_argument("--fresh", action="store_true", help="ignore thread history")
    p.add_argument("--no-thread", action="store_true")
    p.add_argument("--with", dest="with_peers", default=None, help="peers for both/research/huddle, e.g. opus,codex,gemini")
    p.add_argument("--allow-self", action="store_true", help="allow calling the same product (don't)")
    p.add_argument(
        "--cwd",
        default=os.environ.get("PEERS_CWD") or os.getcwd(),
    )
    p.add_argument("--name", default=None)
    p.add_argument("--isolate", action="store_true")
    p.add_argument("--force", action="store_true", default=True)
    p.add_argument("--no-force", action="store_false", dest="force")
    p.add_argument("--dry-run", action="store_true")
    p.add_argument("task", nargs="*", help="task text")


def read_task(args: argparse.Namespace, required: bool = True) -> str:
    if getattr(args, "task_file", None):
        return Path(args.task_file).read_text(encoding="utf-8")
    if getattr(args, "task", None):
        return " ".join(args.task)
    if not sys.stdin.isatty():
        return sys.stdin.read()
    if required:
        die("no task (pass text, --file, or stdin)")
    return ""


def parse_run_args(argv: list[str], default_agent: str = "worker") -> argparse.Namespace:
    p = argparse.ArgumentParser(prog=PROG, add_help=True)
    add_common(p, default_agent=default_agent)
    return p.parse_args(argv)


def main(argv: list[str] | None = None) -> int:
    argv = list(sys.argv[1:] if argv is None else argv)
    if not argv or argv[0] in ("help", "-h", "--help"):
        print(GUIDE.strip() + "\n")
        return 0
    if argv[0] in ("--version", "version"):
        print(f"peers {VERSION}")
        return 0

    cmd = argv[0]
    rest = argv[1:]

    if cmd == "setup":
        return cmd_setup()
    if cmd == "doctor":
        return cmd_doctor()
    if cmd == "providers":
        return cmd_providers()
    if cmd == "last":
        return cmd_last()
    if cmd == "ls":
        return cmd_ls()
    if cmd == "show":
        if not rest:
            die("show needs a run spec (last | id | path)")
        return cmd_show(rest[0])
    if cmd == "cat":
        if not rest:
            die("cat needs a run spec (last | id | path)")
        return cmd_cat(rest[0])
    if cmd == "thread":
        return cmd_thread(rest[0] if rest else None)
    if cmd == "note":
        args = parse_run_args(rest)
        return cmd_note(args, read_task(args))

    if cmd in ("both", "huddle", "parallel", "auto", "research"):
        args = parse_run_args(
            rest,
            default_agent="consult" if cmd == "huddle" else ("research" if cmd == "research" else "worker"),
        )
        if cmd == "huddle":
            task = read_task(args, required=False) or HUDDLE_TASK
            return cmd_huddle(args, task)
        task = read_task(args)
        if cmd == "both":
            return cmd_both(args, task)
        if cmd == "research":
            return cmd_research(args, task)
        if cmd == "parallel":
            return cmd_parallel(args, task)
        return cmd_auto(args, task)

    # `peers <who> …` — any alias or provider, not a hardcoded subparser
    try:
        P.resolve(cmd)
    except KeyError:
        die(f"unknown command or peer '{cmd}'.\n{GUIDE.strip()}")

    args = parse_run_args(rest)
    args.target = cmd
    task = read_task(args)
    rc, _run_dir, _status = run_target(args, task)
    return rc


if __name__ == "__main__":
    raise SystemExit(main())
