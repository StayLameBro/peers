        for p in missing:
            print(f"MISS {p.id:12} {p.hint}")
        for fut in as_completed(futs):
            p = futs[fut]
            state, detail = fut.result()
            tag = {"ok": "ok  ", "auth": "AUTH", "timeout": "TIME", "miss": "MISS"}.get(state, state)
            self = "  [SELF]" if caller and p.id == caller else ""
            print(f"{tag} {p.id:12} {detail}{self}")
            if state == "ok":
                missing_backend = False
            if p.id == "opencode" and state == "ok":
                oc_ok = True
            if p.id == "cursor" and state == "ok":
                cursor_ok = True
            if state == "auth":
                need_login.append((p.id, p.login))
                print(f"     run:       {p.login}")
