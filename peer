def cmd_thread(name: str | None) -> int:
    if not name:
        if not THREADS.exists():
            print("no threads yet")
            return 0
        for d in sorted(THREADS.iterdir()):
            if d.is_dir():
                n = len(load_thread(d.name))
                print(f"{d.name:24} {n} turns  {d / 'thread.md'}")
        return 0
    d = thread_dir(name)
    save_thread(name, load_thread(name))
    sys.stdout.write(read(d / "thread.md"))
    print(f"THREAD: {d / 'thread.md'}", file=sys.stderr)
    return 0


def cmd_ls() -> int:
    if not RUNS.exists():
        print("no runs yet")
        return 0
    rows = sorted(RUNS.iterdir(), key=lambda p: p.stat().st_mtime, reverse=True)[:20]
    print(f"{'run':40} {'who':12} status")
    for d in rows:
        meta = json.loads(read(d / "meta.json") or "{}")
        who = f"{meta.get('target','?'):4} {meta.get('agent','?')}"
        print(f"{d.name:40} {who:12} {meta.get('status','')}")
    return 0


def add_common(p: argparse.ArgumentParser, default_agent: str = "worker") -> None:
    p.add_argument("--agent", choices=AGENTS, default=default_agent)
    p.add_argument("--model", default=None)
    p.add_argument("--timeout", type=int, default=None)
    p.add_argument("--file", dest="task_file", default=None)
    p.add_argument("--against", default=None, help="compat: path to a result.md (same as --see)")
    p.add_argument("--see", action="append", default=None, help="last | thread | run-id | path (repeatable)")
    p.add_argument("--thread", default=None, help="shared desk name; peers can open each other's transcripts")
    p.add_argument("--note", default=None, help="what YOU already know — written onto the thread")
    p.add_argument("--full", action="store_true", help="inline transcripts (use when the peer must not miss context)")
    p.add_argument("--card-only", action="store_true", help="never inline transcripts (paths still included)")
    p.add_argument("--fresh", action="store_true", help="ignore thread history (independent take)")
    p.add_argument("--no-thread", action="store_true", help="do not join a shared desk")
    p.add_argument(
        "--cwd",
        default=os.environ.get("PEER_CWD")
        or os.environ.get("GROK46_CWD")
        or os.environ.get("OPUS_PEER_CWD")
        or os.getcwd(),
    )
    p.add_argument("--name", default=None)
    p.add_argument("--isolate", action="store_true")
    p.add_argument("--force", action="store_true", default=True)
    p.add_argument("--no-force", action="store_false", dest="force")
    p.add_argument("--dry-run", action="store_true")
    p.add_argument("task", nargs="*", help="task text")


def read_task(args: argparse.Namespace, required: bool = True) -> str:
    if getattr(args, "task_file", None):
        return Path(args.task_file).read_text(encoding="utf-8")
    if getattr(args, "task", None):
        return " ".join(args.task)
    if not sys.stdin.isatty():
        return sys.stdin.read()
    if required:
        die("no task (pass text, --file, or stdin)")
    return ""


def inject_prog(argv: list[str]) -> list[str]:
    prog = Path(sys.argv[0]).name
    if not argv:
        return argv
    if prog == "grok46" and argv[0] not in ("-h", "--help"):
        return ["grok", *argv]
    if prog == "opus-peer" and argv[0] not in ("-h", "--help"):
        return ["opus", *argv]
    return argv


def main(argv: list[str] | None = None) -> int:
    argv = list(sys.argv[1:] if argv is None else argv)
    argv = inject_prog(argv)
    if not argv or argv[0] in ("help",):
        print(GUIDE.strip() + "\n")
        return 0
    parser = argparse.ArgumentParser(
        prog="peer",
        description="Two senior models, one desk. Same repo = same thread.",
        epilog="Try: peer grok \"your task\"   then   peer huddle",
        formatter_class=argparse.RawDescriptionHelpFormatter,
    )
    parser.add_argument("--version", action="store_true")
    sub = parser.add_subparsers(dest="cmd", required=False)

    for target in TARGETS:
        p = sub.add_parser(target, help=f"run a {target} peer")
        add_common(p)
        p.set_defaults(target=target)

    p = sub.add_parser("both", help="Grok + Opus independent first pass (then huddle)")
    add_common(p)

    p = sub.add_parser("huddle", help="each senior reads the other's transcript on a thread")
    add_common(p, default_agent="consult")

    p = sub.add_parser("parallel", help="job file: `grok worker: task` per line")
    add_common(p)

    sub.add_parser("doctor", help="check CLIs")
    sub.add_parser("setup", help="install editor skills + PATH shims")
    sub.add_parser("version", help="print version")
    sub.add_parser("last", help="print last RESULT card + transcript path")
    sub.add_parser("ls", help="recent runs")
    p = sub.add_parser("show", help="show a run's RESULT + paths")
    p.add_argument("spec")
    p = sub.add_parser("cat", help="print a run's full TRANSCRIPT")
    p.add_argument("spec")
    p = sub.add_parser("thread", help="show or list threads")
    p.add_argument("name", nargs="?")

    args = parser.parse_args(argv)
    if getattr(args, "version", False) or args.cmd == "version":
        print(f"peerdesk {VERSION}")
        return 0
    if not args.cmd:
        print(GUIDE.strip() + "\n")
        return 0
    if args.cmd == "setup":
        return cmd_setup()
    if args.cmd == "doctor":
        return cmd_doctor()
    if args.cmd == "last":
        return cmd_last()
    if args.cmd == "ls":
        return cmd_ls()
    if args.cmd == "show":
        return cmd_show(args.spec)
    if args.cmd == "cat":
        return cmd_cat(args.spec)
    if args.cmd == "thread":
        return cmd_thread(args.name)
    if args.cmd == "huddle":
        task = read_task(args, required=False) or HUDDLE_TASK
        return cmd_huddle(args, task)
    task = read_task(args)
    if args.cmd == "both":
        return cmd_both(args, task)
    if args.cmd == "parallel":
        return cmd_parallel(args, task)
    rc, _run_dir, _status = run_target(args, task)
    return rc


if __name__ == "__main__":
    raise SystemExit(main())
